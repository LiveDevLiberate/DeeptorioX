# Full Factorio installation; Steam is discovered by default.
# macOS:   FACTORIO_BIN=~/Library/Application Support/Steam/steamapps/common/Factorio/factorio.app/Contents/MacOS/factorio
# Windows: FACTORIO_BIN=C:\Program Files (x86)\Steam\steamapps\common\Factorio\bin\x64\factorio.exe
# FACTORIO_DATA=...  (derived from the executable when omitted)

AUTORIO_PORT=3000
RCON_PORT=27015
# RCON_PASSWORD is generated locally when omitted.
# AUTORIO_DATA_DIR=/absolute/path/to/run-data
# CODEX_BIN=/absolute/path/to/codex
FACTORIO_WINDOW_SIZE=1000x760
# FACTORIO_DISABLE_AUDIO=1
AUTORIO_STARTUP_SECONDS=180
# AUTORIO_TERMINAL=1  # Use optional terminal viewer instead of browser recording view.
# AUTORIO_AGENT_LANGUAGE=Chinese  # Agent messages/reasoning summaries; code/commands stay unchanged.
# AUTORIO_BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Structured manager logs: JSONL in <data-dir>/manager.log, human lines on stderr.
# AUTORIO_LOG_LEVEL=info   # debug|info|warn|error (default info)

# OBS automatic window-only timelapses (requires enabled OBS WebSocket server).
# AUTORIO_OBS=1       # Enable by default; use 0 to disable.
# OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
# OBS_WEBSOCKET_PASSWORD=...  # Optional: defaults to OBS's saved local password.
# OBS_BIN=C:\Program Files\obs-studio\bin\64bit\obs64.exe

# Windows timelapse conversion (macOS uses AVFoundation).
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe

# Optional Node path for ./autorio or autorio.cmd.
# NODE_BIN=C:\Program Files\nodejs\node.exe

# Agent backend: OpenCode by default (use --agent codex to opt into Codex).
# AUTORIO_OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash#low  # #low/#high/#max
# OPENCODE_BIN=/path/to/opencode
# Windows fallback when OpenCode is installed in WSL:
# AUTORIO_WSL_DISTRO=Ubuntu-24.04
# AUTORIO_WSL_OPENCODE=$HOME/.opencode/bin/opencode

# Optional Codex provider override (only with --agent codex).
# AUTORIO_CODEX_PROVIDER=opencode-go
# AUTORIO_CODEX_BASE_URL=https://opencode.ai/inference/go/openai/v1
# AUTORIO_CODEX_ENV_KEY=OPENCODE_API_KEY
# AUTORIO_CODEX_WIRE_API=responses
# AUTORIO_CODEX_CONTEXT_WINDOW=1000000
# OPENCODE_API_KEY=...
# AUTORIO_CODEX_SANDBOX=workspace-write

# DSH (DeepSeek Harness) headless backend (--agent dsh).
# The manager resolves the `dsh` CLI from PATH; override the executable if needed
# (Windows default: <DeepSeek Harness>\resources\runtime\cli\bin\dsh.cmd).
# DSH_BIN=C:\Users\you\AppData\Local\Programs\DeepSeek Harness\resources\runtime\cli\bin\dsh.cmd
# AUTORIO_DSH_PROFILE=headless
# AUTORIO_DSH_PROVIDER=deepseek-official
# AUTORIO_DSH_MODEL=deepseek-flash
# AUTORIO_DSH_REASONING_EFFORT=low   # none|minimal|low|medium|high|xhigh|max|ultra
# Headless ignores the desktop credential store; DEEPSEEK_API_KEY is read from
# the process environment, then from $DSH_HOME/.credentials.yaml, then .env.
# DEEPSEEK_API_KEY=sk-...
# DSH_HOME=C:\Users\you\.dsh

