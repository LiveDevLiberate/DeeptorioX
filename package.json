{
  "name": "factorio-manager",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "description": "Graphical Factorio manager, JSON gameplay API and LLM benchmark runner",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "run": "node dist/run-cli.js",
    "doctor": "npm run build && node scripts/doctor.mjs",
    "test": "npm run build && npm run test:node && npm run test:python",
    "test:node": "node --test tests/*.test.mjs",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:coverage": "npm run coverage",
    "coverage": "npm run build && node scripts/coverage-gate.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "node scripts/release.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:check": "node scripts/install-hooks.mjs --check",
    "verify": "npm run build && npm run test:node && npm run test:python && npm run check:repo && npm run format:check && npm run lint",
    "check:repo": "node scripts/check-repo.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"public/**/*.{js,css}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"package.json\" \"tsconfig.json\" \"eslint.config.mjs\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"public/**/*.{js,css}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"package.json\" \"tsconfig.json\" \"eslint.config.mjs\" \".github/**/*.yml\"",
    "package": "node scripts/package.mjs",
    "selftest": "npm run build && node scripts/run-python-script.mjs scripts/api-selftest.py",
    "cluster": "node scripts/cluster.mjs",
    "mcp": "node dist/mcp-server.js",
    "tools:manifest": "node scripts/tool-manifest.mjs",
    "tools:manifest:check": "node scripts/tool-manifest.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  }
}
